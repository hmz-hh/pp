#!/bin/bash

# تعريف الألوان
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "\n${CYAN}═══════════════════════════════════════════${NC}"
echo -e "${YELLOW}        SYSTEM SPECIFICATION PANEL           ${NC}"
echo -e "${CYAN}═══════════════════════════════════════════${NC}"

# معلومات مزيفة
CPU_INFO="4 Cores (Dedicated Intel Xeon)"
RAM_INFO="12 GB DDR4 ECC"
OS_INFO="[RESTRICTED]"
UPTIME_INFO="--:--"

# عرض البيانات
echo -e "${GREEN} CPU:     ${NC}$CPU_INFO"
echo -e "${GREEN} RAM:     ${NC}$RAM_INFO"
echo -e "${GREEN} OS:      ${NC}$OS_INFO"
echo -e "${GREEN} Uptime:  ${NC}$UPTIME_INFO"

echo -e "${CYAN}═══════════════════════════════════════════${NC}"
echo -e "${YELLOW}  Status: ${GREEN}All Core Modules Running Smoothly${NC}"
echo -e "${CYAN}═══════════════════════════════════════════\n${NC}"
