#!/bin/bash
# Script to manage Cloudflare DNS Records

# 1. تنظيف الملفات القديمة قبل البدء
echo "Cleaning old domain records..."
rm -rf /root/xray/scdomain /root/xray/flare-domain /root/domain /root/nsdomain
rm -rf /etc/xray/domain /etc/xray/flare-domain /etc/xray/scdomain
mkdir -p /root/xray
mkdir -p /etc/xray

# تثبيت الأدوات اللازمة
apt install jq curl -y -q

clear

# 2. توليد اسم عشوائي
sub=$(</dev/urandom tr -dc a-z0-9 | head -c5)

# --- إعدادات الدومين (تأكد أن الدومين مضاف في Cloudflare) ---
DOMAIN="ha-vps.store" 
WS_DOMAIN="ws-${sub}.${DOMAIN}"
FLARE_DOMAIN="flare-${sub}.${DOMAIN}"
NS_DOMAIN="ns-${sub}.${DOMAIN}"
CF_TOKEN="ZJ-HMdxrRwq54Mpv7NbuNlqOW11SaXIKQRQBqLLa"

set -euo pipefail

# جلب IP السيرفر
IP=$(curl -sS ifconfig.me)

echo "Target Domain: ${DOMAIN}"
echo "Server IP: ${IP}"

# 3. الحصول على Zone ID من Cloudflare
ZONE=$(curl -sLX GET "https://api.cloudflare.com/client/v4/zones?name=${DOMAIN}&status=active" \
-H "Authorization: Bearer ${CF_TOKEN}" \
-H "Content-Type: application/json" | jq -r .result[0].id)

if [[ "$ZONE" == "null" ]]; then
    echo "Error: Could not find Zone ID for ${DOMAIN}. Check your Token and Domain."
    exit 1
fi

# 4. تحديث أو إنشاء سجل A (WS_DOMAIN)
echo "Updating DNS for ${WS_DOMAIN}..."
RECORD=$(curl -sLX GET "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records?name=${WS_DOMAIN}" \
-H "Authorization: Bearer ${CF_TOKEN}" \
-H "Content-Type: application/json" | jq -r .result[0].id)

if [[ "${#RECORD}" -le 10 ]]; then
    # إنشاء سجل جديد إذا لم يكن موجوداً
    curl -sLX POST "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records" \
    -H "Authorization: Bearer ${CF_TOKEN}" \
    -H "Content-Type: application/json" \
    --data '{"type":"A","name":"'${WS_DOMAIN}'","content":"'${IP}'","ttl":120,"proxied":false}' > /dev/null
else
    # تحديث السجل الموجود
    curl -sLX PUT "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records/${RECORD}" \
    -H "Authorization: Bearer ${CF_TOKEN}" \
    -H "Content-Type: application/json" \
    --data '{"type":"A","name":"'${WS_DOMAIN}'","content":"'${IP}'","ttl":120,"proxied":false}' > /dev/null
fi

# 5. تحديث أو إنشاء سجل CNAME (FLARE_DOMAIN) مع تفعيل البروكسي
echo "Updating DNS FLARE for ${FLARE_DOMAIN}..."
curl -sLX POST "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records" \
-H "Authorization: Bearer ${CF_TOKEN}" \
-H "Content-Type: application/json" \
--data '{"type":"CNAME","name":"'${FLARE_DOMAIN}'","content":"'${WS_DOMAIN}'","ttl":1,"proxied":true}' > /dev/null

# 6. تحديث أو إنشاء سجل NS (NS_DOMAIN)
echo "Updating DNS NS for ${NS_DOMAIN}..."
curl -sLX POST "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records" \
-H "Authorization: Bearer ${CF_TOKEN}" \
-H "Content-Type: application/json" \
--data '{"type":"NS","name":"'${NS_DOMAIN}'","content":"'${WS_DOMAIN}'","ttl":120,"proxied":false}' > /dev/null

# 7. حفظ البيانات في الملفات المطلوبة
echo "Saving domain info to system files..."
echo $FLARE_DOMAIN > /root/xray/flare-domain
echo $NS_DOMAIN > /root/nsdomain
echo $WS_DOMAIN > /root/domain
echo $FLARE_DOMAIN > /etc/xray/flare-domain
echo $WS_DOMAIN > /etc/xray/domain
echo $WS_DOMAIN > /root/scdomain
echo $WS_DOMAIN > /root/xray/scdomain

# طباعة النتائج النهائية
echo "-------------------------------------------"
echo "Host WS     : $WS_DOMAIN"
echo "Host FLARE  : $FLARE_DOMAIN"
echo "Host NS     : $NS_DOMAIN"
echo "-------------------------------------------"
echo "Done! All records updated successfully."

sleep 1
